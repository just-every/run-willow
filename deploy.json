{
  "version": 1,
  "project": "people/willow",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "r2": [
    {
      "binding": "FILES"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "publicSettings": ["MAIL_PROVIDER", "MAIL_FROM", "MAIL_ACCOUNT_ID", "MAIL_RELAY_URL"],
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "none",
    "MAIL_FROM": "",
    "MAIL_ACCOUNT_ID": "",
    "MAIL_RELAY_URL": ""
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER",
      "optional": true,
      "verifyStandIn": "resend"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "optional": true,
      "verifyStandIn": "auth@example.invalid"
    },
    {
      "binding": "MAIL_ACCOUNT_ID",
      "environment": "MAIL_ACCOUNT_ID",
      "optional": true
    },
    {
      "binding": "MAIL_RELAY_URL",
      "environment": "MAIL_RELAY_URL",
      "optional": true
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY",
      "optional": true,
      "verifyStandIn": "test-only-provider-key"
    }
  ],
  "platforms": [
    "workers",
    "container"
  ]
}
