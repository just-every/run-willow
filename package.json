{
  "name": "@people/willow",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-willow"
  },
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:email-link": "rer queue test:email-link -- sh -c \"node tests/email-link.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "node scripts/verify-app.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:flows": "rer queue test:flows -- sh -c \"node tests/willow/flows.mjs\"",
    "test:journey": "node tests/willow/journey.mjs && node tests/willow/restore-access.mjs",
    "test:regressions": "node tests/willow/regressions.mjs",
    "test:restore-access": "node tests/willow/restore-access.mjs",
    "test:phase2": "node tests/willow/phase2.mjs",
    "test:retention-eeo": "node tests/willow/retention.mjs && node tests/willow/eeo-self-id.mjs && node tests/willow/eeo-snapshot.mjs",
    "test:restore-erasure": "node tests/willow/restore-erasure.mjs",
    "test:phase2-browser": "WILLOW_PHASE2_BROWSER=1 node tests/willow/phase2.mjs",
    "test:site": "rer build --site && node tests/willow/site.mjs",
    "test:open-source": "node tests/willow/open-public-start.mjs",
    "delivery:spec": "node scripts/build-deployment-spec.mjs",
    "check:deployment-spec": "node scripts/build-deployment-spec.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.56.1",
    "@runeditrun/rer": "0.2.79",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.17.1",
    "marked": "18.0.14",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
