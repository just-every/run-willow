{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "people-willow",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "willow",
      "database_id": "local-willow-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "people-willow-files"
    }
  ]
}
